---
import '../styles/global.css';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getConfig } from '../lib/tina/data';
import { islands } from '../lib/tina/islands';

interface Props { title?: string; description?: string; }
const { title = 'TinaCMS + Astro', description = 'Reusable blocks starter' } = Astro.props;
const config = (await getConfig()).data?.config ?? null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,600;8..60,700;8..60,800&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <TinaIsland name="global" wrapper={islands.global.wrapper}><Header config={config} /></TinaIsland>
    <slot />
    <TinaIsland name="global-footer" wrapper={islands['global-footer'].wrapper}><Footer config={config} /></TinaIsland>
    <script src="/js/tina-guard.js" is:inline></script>
  </body>
</html>
