---
interface Props { fill?: string; flip?: boolean }
const { fill = 'var(--paper-2)', flip = false } = Astro.props;
---
<div class="wave-divider" style={`background:${fill};transform:${flip ? 'scaleY(-1)' : 'none'}`} aria-hidden="true">
  <svg viewBox="0 0 1200 28" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" role="img">
    <path class="wave-back" d="M0 14 C150 28 300 0 450 14 C600 28 750 0 900 14 C1050 28 1150 8 1200 14 L1200 28 L0 28 Z" fill={fill} opacity="0.55"></path>
    <path class="wave-front" d="M0 16 C120 26 280 4 420 16 C580 28 720 6 860 16 C1010 26 1100 10 1200 16 L1200 28 L0 28 Z" fill={fill}></path>
  </svg>
</div>
