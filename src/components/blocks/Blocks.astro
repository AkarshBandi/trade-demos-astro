---
import { tinaField } from '@tinacms/astro/tina-field';
import Hero from './Hero.astro';
import RichText from './RichText.astro';
import Media from './Media.astro';
import Cta from './Cta.astro';
import Gallery from './Gallery.astro';
import Accordion from './Accordion.astro';
import Stats from './Stats.astro';
import Testimonial from './Testimonial.astro';
import Pricing from './Pricing.astro';
import WaveDivider from '../WaveDivider.astro';

const { data } = Astro.props as { data: any };
const blocks = (data?.blocks ?? []).filter(Boolean);
function typename(b: any) {
  return b?.__typename ?? (b?._template ? `PageBlocks${b._template.charAt(0).toUpperCase()+b._template.slice(1)}` : undefined);
}
---
{blocks.map((block: any, i: number) => {
  const tn = typename(block);
  const rendered = (() => {
    switch (tn) {
      case 'PageBlocksHero':
        return <Hero data={block} />;
      case 'PageBlocksRichText':
        return <RichText data={block} />;
      case 'PageBlocksMedia':
        return <Media data={block} />;
      case 'PageBlocksCta':
        return <Cta data={block} />;
      case 'PageBlocksGallery':
        return <Gallery data={block} />;
      case 'PageBlocksAccordion':
        return <Accordion data={block} />;
      case 'PageBlocksStats':
        return <Stats data={block} />;
      case 'PageBlocksTestimonial':
        return <Testimonial data={block} />;
      case 'PageBlocksPricing':
        return <Pricing data={block} />;
      default:
        return null;
    }
  })();
  return (
    <>
      <div data-tina-field={tinaField(block)}>{rendered}</div>
      {i < blocks.length -1 && tn !== 'PageBlocksHero' && <WaveDivider fill="var(--paper-2)" />}
    </>
  );
})}
