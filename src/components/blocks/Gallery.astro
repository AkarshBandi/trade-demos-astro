---
import { tinaField } from '@tinacms/astro/tina-field';
const { data } = Astro.props as { data: any };
const images = (data?.images ?? []).filter(Boolean);
---
<section class="block-gallery" style="max-width:1120px;margin:0 auto;padding:48px 24px" data-tina-field={tinaField(data, 'images')}>
  {data?.headline && <h2 style="font-size:clamp(1.5rem,4vw,2rem);margin-bottom:24px" data-tina-field={tinaField(data, 'headline')}>{data.headline}</h2>}
  <div style="display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))">
    {images.map((img: any) => (
      <figure style="margin:0">
        {img?.src && <img src={img.src} alt={img.alt ?? ''} style="width:100%;aspect-ratio:4/3;object-fit:cover" loading="lazy" />}
        {img?.caption && <figcaption style="margin-top:6px;font-size:12px;opacity:0.6">{img.caption}</figcaption>}
      </figure>
    ))}
  </div>
</section>
