---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsConfig } from '../lib/tina/data';
interface Props { config?: CmsConfig | null; }
const { config } = Astro.props as any;
const footerNote = (config as any)?.footerNote ?? '© ' + new Date().getFullYear() + ' — Built with TinaCMS + Astro';
---
<footer style="border-top:1px solid #eee;margin-top:48px;padding:32px 24px;text-align:center">
  <p style="font-size:13px;opacity:0.6" data-tina-field={tinaField(config as any, 'footerNote')}>{footerNote}</p>
</footer>
