---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsConfig } from '../lib/tina/data';
interface Props { config?: CmsConfig | null; }
const { config } = Astro.props as any;
const footer = (config as any)?.footer ?? {};
const wordmark = footer.wordmark ?? (config as any)?.seo?.title ?? 'Trade Demos';
const wordmarkSub = footer.wordmarkSub ?? '';
const blurb = footer.blurb ?? '';
const columns = Array.isArray(footer.columns) ? footer.columns : [];
const footerNote = footer.footerNote ?? '';
const credit = footer.credit ?? '';
---
<footer class="site-footer">
  <div class="container">
    <div style="display:grid;grid-template-columns:1.4fr 0.8fr 0.8fr 0.8fr;gap:2rem;padding-bottom:1.5rem">
      <div>
        <p class="wordmark" style="color:#fff">
          <span data-tina-field={tinaField(footer, 'wordmark')}>{wordmark}</span>
          {wordmarkSub && <small style="color:#8B9AB0" data-tina-field={tinaField(footer, 'wordmarkSub')}>{wordmarkSub}</small>}
        </p>
        {blurb && <p class="small" style="color:#A8B2BF;margin-top:0.6rem;max-width:36ch" data-tina-field={tinaField(footer, 'blurb')}>{blurb}</p>}
      </div>
      {columns.map((col: any) => (
        <nav style="display:flex;flex-direction:column;gap:0.5rem" data-tina-field={tinaField(footer, 'columns')}>
          <p style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#8B9AB0">{col.heading}</p>
          {(col.links ?? []).map((l: any) => (
            <a href={l.link} class="small">{l.title}</a>
          ))}
        </nav>
      ))}
    </div>
    <div style="display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;border-top:1px solid #263445;padding-top:1rem;font-size:0.82rem;color:#6A7685">
      {footerNote && <span data-tina-field={tinaField(footer, 'footerNote')}>{footerNote}</span>}
      {credit && <span class="mono" data-tina-field={tinaField(footer, 'credit')}>{credit}</span>}
    </div>
  </div>
</footer>
