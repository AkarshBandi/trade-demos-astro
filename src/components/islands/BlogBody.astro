---
import { tinaField } from '@tinacms/astro/tina-field';
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
const { data } = Astro.props as { data: any };
---
<article style="max-width:720px;margin:0 auto;padding:64px 24px">
  <p style="letter-spacing:0.2em;text-transform:uppercase;font-size:11px;opacity:0.6" data-tina-field={tinaField(data, 'pubDate')}>{data?.pubDate ? new Date(data.pubDate).toLocaleDateString() : ''}</p>
  <h1 style="font-size:clamp(2rem,5vw,2.8rem);margin:8px 0 12px" data-tina-field={tinaField(data, 'title')}>{data?.title}</h1>
  {data?.description && <p style="opacity:0.7" data-tina-field={tinaField(data, 'description')}>{data.description}</p>}
  {data?.heroImage && <img src={data.heroImage} alt={data.title ?? ''} style="width:100%;margin:24px 0" data-tina-field={tinaField(data, 'heroImage')} />}
  {data?.body && (
    <div style="line-height:1.8" data-tina-field={tinaField(data, 'body')}>
      <TinaMarkdown content={data.body} />
    </div>
  )}
</article>
