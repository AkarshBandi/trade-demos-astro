---
import Base from '../../layouts/Base.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import BlogBody from '../../components/islands/BlogBody.astro';
import { getBlog, listBlogs } from '../../lib/tina/data';
import { islands } from '../../lib/tina/islands';

export async function getStaticPaths() {
  const blogs = await listBlogs();
  return blogs
    .map((b: any) => b?._sys?.filename)
    .filter(Boolean)
    .map((slug: string) => ({ params: { slug } }));
}

const slug = (Astro.params.slug ?? '').toString();
const post = await getBlog(slug);
const data = post.data?.blog;
if (!data) return new Response('Not Found', { status: 404 });
---

<Base title={data.title ?? slug}>
  <TinaIsland name="blog" wrapper={islands.blog.wrapper} params={{ slug }} primary>
    <BlogBody data={data} />
  </TinaIsland>
</Base>
