<script is:inline>/* safety: if motion setup stalls, never leave sections hidden */setTimeout(function(){if(!document.documentElement.dataset.motion)document.documentElement.classList.add('no-motion')},2500);</script>
<script>
import gsap from 'gsap';
import {ScrollTrigger} from 'gsap/ScrollTrigger';
import Lenis from 'lenis';
document.documentElement.dataset.motion='ok';document.documentElement.classList.remove('no-motion');
const hdr=document.querySelector('.site-header');
if(hdr)addEventListener('scroll',()=>hdr.style.background=scrollY>8?'rgba(26,37,53,0.98)':'rgba(26,37,53,0.96)',{passive:true});
const reduceMotion=matchMedia('(prefers-reduced-motion: reduce)').matches;
let motionOk=false;
try{
if(!reduceMotion){
  gsap.registerPlugin(ScrollTrigger);
  const lenis=new Lenis({duration:0.9,smoothWheel:true});
  lenis.on('scroll',ScrollTrigger.update);
  gsap.ticker.add((t)=>lenis.raf(t*1000));
  gsap.ticker.lagSmoothing(0);
  document.querySelectorAll('a[href^="#"]').forEach(a=>a.addEventListener('click',e=>{
    const id=a.getAttribute('href');
    if(id&&id.length>1){const target=document.querySelector(id);
      if(target){e.preventDefault();lenis.scrollTo(target,{offset:-72})}}
  }));
  motionOk=true;
}
}catch(err){motionOk=false}
if(motionOk){
  document.documentElement.classList.add('gsap');
  gsap.registerPlugin(ScrollTrigger);
  gsap.timeline({defaults:{ease:'power3.out'}})
    .from('.hero .kicker',{y:18,opacity:0,duration:0.6},0.1)
    .from('.hero h1',{y:28,opacity:0,duration:0.7},0.2)
    .from('.hero .lede',{y:20,opacity:0,duration:0.6},0.32)
    .from('.hero__actions',{y:16,opacity:0,duration:0.5},0.42)
    .from('.hero__content > p.small',{opacity:0,duration:0.5},0.5);
  gsap.to('.hero img',{yPercent:8,ease:'none',scrollTrigger:{trigger:'.hero',start:'top top',end:'bottom top',scrub:true}});
}
/* Visibility is ALWAYS owned by IO (.in) — GSAP only adds transform motion on top, never opacity. Nothing can get stuck hidden. */
const riseGroups=new Map();
document.querySelectorAll('.work-grid .work-card,.journal img,.tabs .tab').forEach(el=>{
  const key=el.parentElement;
  if(!riseGroups.has(key))riseGroups.set(key,[]);
  el.dataset.rise=riseGroups.get(key).length;
  riseGroups.get(key).push(el);
});
const obs=new IntersectionObserver((es)=>{es.forEach(e=>{
  if(!e.isIntersecting)return;
  const el=e.target;
  const alreadyIn=el.classList.contains('in');
  el.classList.add('in');
  if(motionOk&&!alreadyIn&&(el.classList.contains('work-card')||el.classList.contains('tab')||el.closest('.journal'))){
    gsap.fromTo(el,{y:26},{y:0,duration:0.6,delay:Math.min(parseInt(el.dataset.rise||'0',10)*0.08,0.4),ease:'power3.out',overwrite:'auto'});
  }else if(motionOk&&!alreadyIn&&el.classList.contains('reveal')){
    gsap.fromTo(el,{y:22},{y:0,duration:0.6,ease:'power3.out',overwrite:'auto'});
  }
  if(el.hasAttribute('data-count')){const t=parseInt(el.getAttribute('data-count'));let c=0;const s=Math.max(1,Math.ceil(t/36));const tick=()=>{c=Math.min(t,c+s);el.textContent=c+(t>100?'+':''); if(c<t) requestAnimationFrame(tick)}; tick()}
  obs.unobserve(el);
})},{threshold:0.15});
document.querySelectorAll('.reveal,[data-count]').forEach(el=>obs.observe(el));
const tabs=[...document.querySelectorAll('[role="tab"]')];
tabs.forEach((tab,i)=>{
  tab.addEventListener('click',()=>selectTab(i));
  tab.addEventListener('keydown',e=>{
    if(e.key!=='ArrowRight'&&e.key!=='ArrowLeft')return;
    e.preventDefault();
    const n=(i+(e.key==='ArrowRight'?1:tabs.length-1))%tabs.length;
    selectTab(n);tabs[n].focus();
  });
});
function selectTab(i){
  tabs.forEach((t,j)=>{
    const on=j===i;
    t.setAttribute('aria-selected',on?'true':'false');
    t.tabIndex=on?0:-1;
    const panel=document.getElementById(t.getAttribute('aria-controls'));
    panel.hidden=!on;
    if(on&&motionOk)gsap.fromTo(panel,{y:14,opacity:0},{y:0,opacity:1,duration:0.4,ease:'power2.out'});
  });
}
</script>
