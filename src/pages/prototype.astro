<script>
addEventListener('scroll',()=>{}, {passive:true});
const obs=new IntersectionObserver((ents)=>{ents.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in'); if(e.target.hasAttribute('data-count')||e.target.querySelector('[data-count]')){(e.target.querySelectorAll('[data-count]').forEach(el=>{const t=parseInt(el.getAttribute('data-count'));let c=0;const step=Math.max(1,Math.ceil(t/48));const tick=()=>{c=Math.min(t,c+step);el.textContent=c+(t>100?'+':'');if(c<t) requestAnimationFrame(tick)};tick()}))} obs.unobserve(e.target)}})},{threshold:0.18});
document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));
// count all on load for strip
document.querySelectorAll('.stat__val[data-count]').forEach(el=>{const t=parseInt(el.getAttribute('data-count'));let c=0;const step=Math.max(1,Math.ceil(t/48));const io=new IntersectionObserver(es=>{es.forEach(x=>{if(x.isIntersecting){const tick=()=>{c=Math.min(t,c+step);el.textContent=c+(t>100?'+':'');if(c<t) requestAnimationFrame(tick)};tick();io.disconnect()}})},{threshold:0.4});io.observe(el)});
document.querySelectorAll('.cover .btn').forEach(b=>b.addEventListener('click',()=>{const i=b.previousElementSibling;const v=i?.value?.trim();const hint=b.closest('.cover__grid')?.querySelector('.small.muted');if(hint)hint.textContent=v?`Checking ${v}, yes, 19 jobs there, avg 47min.`:`Try 85201`}));
document.querySelectorAll('form').forEach(f=>f.addEventListener('submit',e=>{e.preventDefault();const b=f.querySelector('button');if(b){b.textContent='Checking...';setTimeout(()=>b.textContent='We will text in 4 min',900)}}));
</script>
