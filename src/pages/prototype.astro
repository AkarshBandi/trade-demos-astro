---
// Prototype HVAC — NEW wireframe (replacement, not tweak)
// Jobs: emergency -> proof -> cost+finance -> process -> wall-of-love -> coverage -> book
// Blocks: red band, Hero Forms + coupon overlap, gap-px stats, van steps, table+finance band, marquee, 5/7 map, dark CTA card
// Human: straight, 4 hues, varied radii 4/6/8/12/16/999, 1px hairline, 3 distinct hovers, no button underlines
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Apex Air Pros — HVAC Mesa AZ — Prototype</title>
<meta name="description" content="Prototype — AC out at 110°? We fix it today. Family shop in Mesa, van 7 texts his face and ETA." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
<style>
/* HVAC color graph — 4 hues only
   paper #FCFCF9 60% — warm paper, lets photos lead
   ink #0F2439 30% — condenser matte, feels built
   line #E6DDD4 5% — limestone dust hairline, 1px rules only
   brick #C1272D 5% — oxide red, spray cap, only pill + primary CTA, never gradient
*/
:root{
  --paper:#FCFCF9; --paper-2:#F6F1EB; --slate:#F8FAFC;
  --ink:#0F2439; --ink-2:#2A3A4D; --ink-3:#6A7685;
  --line:#E6DDD4; --line-2:#D8D0BF;
  --brick:#C1272D; --brick-2:#9E1F24;
  --font-serif:"Source Serif 4",Georgia,serif;
  --font-sans:"IBM Plex Sans",system-ui,sans-serif;
  --font-mono:"IBM Plex Mono",monospace;
  --r-badge:4px; --r-field:6px; --r-card:8px; --r-coupon:12px; --r-hero:16px; --r-pill:999px;
  --shadow-sm:0 1px 2px rgba(15,36,57,0.06);
  --shadow-lift:0 8px 24px -12px rgba(15,36,57,0.14);
}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;overflow-x:clip}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;font-family:var(--font-sans);color:var(--ink);background:var(--paper);line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%}
.container{width:100%;max-width:1120px;margin:0 auto;padding:0 clamp(16px,3vw,32px)}
/* 1 — emergency band: thin, straight, mono */
.emergency{background:var(--brick);color:#fff;font-family:var(--font-mono);font-size:12px;letter-spacing:0.04em}
.emergency__inner{max-width:1120px;margin:0 auto;padding:8px clamp(16px,3vw,32px);display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:center}
.emergency a{font-weight:600;text-decoration:none;border-bottom:1px solid rgba(255,255,255,0.4)}
/* 2 — header: solid paper + 1px rule, left, no blur */
.site-header{position:sticky;top:0;z-index:30;background:var(--paper);border-bottom:1px solid var(--line)}
.site-header__inner{display:flex;align-items:center;justify-content:space-between;gap:20px;height:64px}
.wordmark{font-family:var(--font-serif);font-weight:700;font-size:1.2rem;letter-spacing:-0.02em}
.wordmark small{font-family:var(--font-mono);font-weight:400;font-size:0.62rem;letter-spacing:0.08em;color:var(--ink-3);margin-left:6px}
.demo-tag{display:inline-block;margin-left:8px;background:var(--paper-2);border:1px solid var(--line);color:var(--ink-3);font-family:var(--font-mono);font-size:9px;letter-spacing:0.08em;text-transform:uppercase;padding:2px 6px;border-radius:var(--r-pill)}
.nav{display:flex;align-items:center;gap:18px}
.nav a.navlink{font-size:0.85rem;color:var(--ink-2);text-decoration:none}
.nav a.navlink:hover{color:var(--ink)}
/* 3 — buttons: 3 distinct hovers, no underlines anywhere on buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;padding:0.78rem 1.15rem;font-family:var(--font-sans);font-weight:600;font-size:0.88rem;border:1px solid var(--ink);background:var(--ink);color:var(--paper);border-radius:var(--r-field);cursor:pointer;text-decoration:none;transition:box-shadow 200ms,background 160ms,border-color 160ms}
.btn--accent{position:relative;isolation:isolate;overflow:hidden;background:var(--ink);border-color:var(--ink);color:#fff}
.btn--accent::before{content:"";position:absolute;inset:0;z-index:-1;background:var(--brick);transform:scaleX(0);transform-origin:left;transition:transform 240ms cubic-bezier(0.22,1,0.36,1)}
.btn--accent:hover::before{transform:scaleX(1)}
.btn--accent:hover{border-color:var(--brick-2)}
.btn--accent .arr{transition:transform 180ms cubic-bezier(0.22,1,0.36,1)}
.btn--accent:hover .arr{transform:translateX(3px)}
.btn--ghost{background:#fff;color:var(--ink);border-color:var(--line-2)}
.btn--ghost:hover{background:#FFFBF7;border-color:var(--ink-3)}
.btn--phone .ico{transition:transform 180ms cubic-bezier(0.22,1,0.36,1)}
.btn--phone:hover .ico{transform:rotate(-12deg) scale(1.08)}
.btn--phone:hover{box-shadow:0 0 0 4px rgba(193,39,45,0.12)}
.btn--pill{border-radius:var(--r-pill)}
.btn,.btn:hover,.btn:focus{text-decoration:none}
.link-arrow{display:inline-flex;align-items:center;gap:6px;font-weight:600;font-size:0.88rem;color:var(--ink);text-decoration:none}
.link-arrow .arr{transition:transform 180ms cubic-bezier(0.22,1,0.36,1)}
.link-arrow:hover .arr{transform:translateX(4px)}
/* 4 — hero forms: 7/5 split, straight image + coupon overlap, no rotation */
.hero{background:var(--paper);padding:40px 0 56px;border-bottom:1px solid var(--line)}
.hero__grid{display:grid;grid-template-columns:7fr 5fr;gap:40px;align-items:start}
@media(max-width:900px){.hero__grid{grid-template-columns:1fr}}
.kicker{font-family:var(--font-mono);font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-2);font-weight:600}
.kicker--sm{font-size:12px}
/* M1 triage strip — THE only eyebrow in HVAC middle lives here */
.triage{background:var(--paper-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:48px 0}
.triage__grid{display:grid;grid-template-columns:1fr 1.2fr;gap:28px;align-items:start}
@media(max-width:900px){.triage__grid{grid-template-columns:1fr}}
.sym-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:6px}
@media(max-width:640px){.sym-grid{grid-template-columns:1fr}}
.sym{background:#fff;border:1px solid var(--line-2);border-radius:8px;min-height:48px;padding:12px;font-weight:600;font-size:0.9rem;color:var(--ink);cursor:pointer;font-family:var(--font-sans)}
.sym:hover{border-color:var(--ink)}
/* M2 visit split — plain H2, no kicker; ink band */
.visit{background:var(--ink);color:#fff;padding:48px 0}
.visit__grid{display:grid;grid-template-columns:1.2fr 0.8fr;gap:24px;align-items:start}
@media(max-width:900px){.visit__grid{grid-template-columns:1fr}.visit__card{order:-1}}
.visit__row{display:grid;grid-template-columns:44px 1fr;gap:12px;padding:14px 0;border-bottom:1px solid #243041}
.visit__n{width:44px;height:44px;border-radius:50%;border:1px solid #2A3A4D;display:grid;place-items:center;font-family:var(--font-mono);font-size:13px;font-weight:600;color:#fff}
.visit__card{background:var(--paper);color:var(--ink);border:1px solid var(--line);border-radius:12px;padding:20px;box-shadow:0 8px 24px -12px rgba(0,0,0,0.3)}
/* M3 pay table — inline label only, rows stack on mobile */
.pay{background:var(--paper);border-bottom:1px solid var(--line);padding:48px 0}
.pay__table{margin-top:20px;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#fff}
.pay__row{display:grid;grid-template-columns:1.4fr 1fr 1fr auto;align-items:center}
.pay__row.head{background:var(--paper-2)}
.pay__cell{padding:14px 16px;border-bottom:1px solid var(--line);font-size:0.92rem;color:var(--ink)}
.pay__row.head .pay__cell{font-family:var(--font-mono);font-size:12px;letter-spacing:0.06em;text-transform:uppercase;color:var(--ink-2);font-weight:600}
.pay__row:last-child .pay__cell{border-bottom:none}
@media(max-width:720px){.pay__row{grid-template-columns:1fr;padding:6px 0}.pay__row.head{display:none}.pay__cell{border-bottom:none;padding:4px 16px}.pay__cell:first-child{padding-top:14px}.pay__cell:last-child{padding-bottom:14px}}
.pay__table{margin-top:20px;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#fff}
.pay__row{display:grid;grid-template-columns:1.3fr 1fr 1fr auto;gap:0;align-items:center}
@media(max-width:720px){.pay__row{grid-template-columns:1fr;padding:14px 16px;gap:6px}.pay__row.head{display:none}}
.pay__cell{padding:14px 16px;border-bottom:1px solid var(--line);font-size:0.92rem}
.pay__inline{font-family:var(--font-mono);font-size:12px;letter-spacing:0.06em;text-transform:uppercase;color:var(--ink-2);font-weight:600}
.hero h1{font-family:var(--font-serif);font-weight:700;line-height:1.04;letter-spacing:-0.02em;font-size:clamp(2.2rem,4vw + 1rem,3.2rem);margin-top:10px}
.hero h1 em{font-style:normal;color:var(--brick)}
.lede{max-width:36rem;margin-top:12px;color:var(--ink-2);font-size:1.02rem;line-height:1.6}
.usp{display:flex;flex-wrap:wrap;margin-top:16px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.usp div{padding:10px 16px 10px 0;margin-right:16px;font-family:var(--font-mono);font-size:11px;letter-spacing:0.06em;text-transform:uppercase;color:var(--ink-2)}
.usp div + div{border-left:1px solid var(--line);padding-left:16px}
.rating{margin-top:14px;display:flex;gap:12px;align-items:center;border:1px solid var(--line);border-radius:var(--r-card);background:#fff;padding:10px 14px;box-shadow:var(--shadow-sm);max-width:380px}
.hero__media{position:relative;margin-right:-16px}
@media(max-width:900px){.hero__media{margin-right:0}}
.hero__frame{border:1px solid var(--line);border-radius:var(--r-hero);overflow:hidden;background:#fff;box-shadow:var(--shadow-sm)}
.hero__frame img{width:100%;height:360px;object-fit:cover;display:block;border-radius:2px}
.hero__frame-cap{display:flex;justify-content:space-between;align-items:center;padding:10px 14px;border-top:1px solid var(--line);background:#FFFBF7;font-family:var(--font-mono);font-size:11px;letter-spacing:0.06em;text-transform:uppercase;color:var(--ink-3)}
.coupon{position:relative;margin:-28px 20px 0;background:#fff;border:1px solid var(--line-2);border-radius:var(--r-coupon);padding:14px 16px;box-shadow:var(--shadow-lift)}
.coupon__tag{display:inline-block;background:var(--brick);color:#fff;font-family:var(--font-mono);font-size:10px;letter-spacing:0.08em;text-transform:uppercase;padding:3px 8px;border-radius:var(--r-badge)}
.field{width:100%;padding:0.78rem 0.9rem;border:1px solid var(--line-2);background:#fff;border-radius:var(--r-field);font-family:var(--font-sans);font-size:0.95rem}
.field:focus{outline:none;border-color:var(--ink)}
.field::placeholder{color:#8B95A3;opacity:1}
.field--dark{background:var(--ink);color:#fff;border-color:#2A3A4D}
.field--dark::placeholder{color:rgba(255,255,255,0.72)}
.muted{color:var(--ink-3)}
.small{font-size:0.88rem}
/* 5 — stats: gap-px hairline strip, not cards */
.stats{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--paper-2)}
.stats__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line)}
@media(max-width:860px){.stats__grid{grid-template-columns:1fr 1fr}}
.stat-cell{background:var(--paper);padding:22px 20px}
.stat__val{font-family:var(--font-serif);font-weight:700;font-size:1.9rem;line-height:1;letter-spacing:-0.02em}
.stat__val span{color:var(--brick)}
.stat__label{margin-top:6px;font-family:var(--font-mono);font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:var(--ink-3)}
/* 6 — process: 5 steps horizontal + dotted connector, straight round icons */
.process{background:var(--paper);border-bottom:1px solid var(--line);padding:48px 0}
.steps{display:flex;gap:18px;margin-top:22px;position:relative}
@media(max-width:900px){.steps{flex-direction:column}}
.steps::before{content:"";position:absolute;top:32px;left:32px;right:32px;border-top:1px dashed var(--line-2)}
@media(max-width:900px){.steps::before{display:none}}
.step{position:relative;flex:1;background:#fff;border:1px solid var(--line);border-radius:var(--r-card);padding:16px;box-shadow:var(--shadow-sm)}
.step__icon{width:56px;height:56px;border-radius:50%;background:#fff;border:1px solid var(--line-2);display:grid;place-items:center;font-family:var(--font-mono);font-size:13px;font-weight:600;position:relative;z-index:1}
.step__num{position:absolute;top:10px;right:12px;font-family:var(--font-serif);font-weight:700;font-size:2rem;color:rgba(15,36,57,0.08);line-height:1}
/* 7 — finance band + table: kills SaaS 3 cards */
.finance{background:var(--ink);color:#fff;border-top:1px solid #1A3350;border-bottom:1px solid #1A3350}
.finance__inner{max-width:1120px;margin:0 auto;padding:36px clamp(16px,3vw,32px);display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:center}
@media(max-width:900px){.finance__inner{grid-template-columns:1fr}}
.compare{background:var(--paper);border-bottom:1px solid var(--line);padding:48px 0}
.compare__table{margin-top:20px;border:1px solid var(--line);border-radius:var(--r-card);overflow:hidden;background:#fff}
.compare__row{display:grid;grid-template-columns:1.2fr 1fr 1fr 1fr;gap:0}
@media(max-width:720px){.compare__row{grid-template-columns:1fr 1fr;font-size:0.85rem}}
.compare__cell{padding:14px 16px;border-bottom:1px solid var(--line);font-size:0.92rem}
.compare__cell.head{background:var(--paper-2);font-family:var(--font-mono);font-size:11px;letter-spacing:0.06em;text-transform:uppercase;color:var(--ink-3)}
.compare__cell.hl{background:var(--ink);color:#fff}
.compare__cell.hl strong{color:#fff}
/* 8 — marquee */
.marquee{--gap:16px;display:flex;gap:var(--gap);overflow:hidden;mask-image:linear-gradient(to right,transparent,black 8%,black 92%,transparent)}
.marquee__track{display:flex;gap:var(--gap);will-change:transform;animation:marquee 30s linear infinite}
.marquee:hover .marquee__track,.marquee:focus-within .marquee__track{animation-play-state:paused}
@keyframes marquee{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
@media(prefers-reduced-motion:reduce){.marquee__track{animation:none;overflow-x:auto;scroll-snap-type:x mandatory}}
.testi-card{width:320px;flex-shrink:0;background:#fff;border:1px solid var(--line);border-radius:var(--r-card);padding:16px;box-shadow:var(--shadow-sm)}
.testi-card--wide{width:380px}
.proof{background:var(--paper-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:48px 0}
/* 9 — coverage 5/7 offset dual-pin */
.cover{background:var(--paper);border-bottom:1px solid var(--line);padding:48px 0}
.cover__grid{display:grid;grid-template-columns:5fr 7fr;gap:24px;align-items:start}
@media(max-width:900px){.cover__grid{grid-template-columns:1fr}}
.area-list{border-top:1px solid var(--line);margin-top:14px}
.area-list div{display:flex;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid var(--line);font-size:0.92rem}
.map{position:relative;border:1px solid var(--line);border-radius:var(--r-card);overflow:hidden;background:#fff;box-shadow:var(--shadow-sm)}
.map img{width:100%;height:320px;object-fit:cover;display:block}
.pin{position:absolute;background:#fff;border:1px solid var(--line-2);border-radius:var(--r-field);padding:8px 10px;box-shadow:var(--shadow-lift);font-family:var(--font-mono);font-size:11px}
/* 10 — dark CTA card */
.cta-wrap{background:var(--paper);padding:48px clamp(16px,3vw,32px)}
.cta-card{max-width:1120px;margin:0 auto;background:var(--ink);color:#fff;border:1px solid #1A3350;border-radius:var(--r-hero);padding:32px;display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:center}
@media(max-width:900px){.cta-card{grid-template-columns:1fr}}
.cta-form{background:#fff;border-radius:var(--r-card);padding:18px;color:var(--ink)}
.footer{background:var(--ink);color:#D8DDE3;padding:36px 0 28px;border-top:1px solid #243041;margin-top:0}
.reveal{opacity:0;transform:translateY(8px);transition:opacity 420ms,transform 420ms}
.reveal.in{opacity:1;transform:none}
@media(max-width:860px){.nav a.navlink{display:none}}
:focus-visible{outline:2px solid var(--brick);outline-offset:2px}
@media(prefers-reduced-motion:reduce){.marquee__track,.reveal{animation:none;transition:none}.reveal{opacity:1;transform:none}}
</style>
</head>
<body>
<div class="emergency"><div class="emergency__inner"><span>24/7 Emergency — No extra charge nights, weekends, holidays</span><a href="tel:4806606150">(480) 660-6150 — Call now</a></div></div>
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/prototype" class="wordmark">APEX AIR PROS <small>MESA · SINCE 2012</small> <span class="demo-tag">Demo</span></a>
    <nav class="nav" aria-label="Primary">
      <a class="navlink" href="#triage">Symptoms</a><a class="navlink" href="#visit">Visit</a><a class="navlink" href="#pay">Cost</a>
      <a href="#book" class="btn btn--ghost" style="padding:0.55rem 0.9rem;font-size:0.84rem;border-radius:6px">Check availability</a>
      <a href="tel:4806606150" class="btn btn--accent btn--phone btn--pill" style="padding:0.6rem 1rem"><span class="ico" aria-hidden>◉</span> (480) 660-6150</a>
    </nav>
  </div>
</header>

<section class="hero">
  <div class="container hero__grid">
    <div class="reveal in">
      <p class="kicker">Mesa · Gilbert · Chandler — Since 2012</p>
      <h1>AC out at 110°?<br><em>We fix it today.</em></h1>
      <p class="lede">Family shop in Mesa. If it is a $18 part at the store, we say buy it there, no trip. Van 7 texts you his face and ETA. That is the whole pitch.</p>
      <div class="rating"><div style="width:36px;height:36px;border-radius:50%;background:var(--ink);color:#fff;display:grid;place-items:center;font-weight:700">4.9</div><div><p style="font-weight:600;font-size:0.9rem">Google 4.9 — 412 reviews</p><p class="small muted">Same-day 96% — Mesa shop, not a call center</p></div></div>
      <div class="usp"><div>Same-day guaranteed</div><div>Lifetime guarantee</div><div>$0 down financing</div></div>
      <div style="display:flex;gap:10px;margin-top:16px;flex-wrap:wrap">
        <a href="#book" class="btn btn--accent" style="border-radius:6px">Book repair <span class="arr" aria-hidden>→</span></a>
        <a href="tel:4806606150" class="btn btn--ghost" style="border-radius:6px">Call now</a>
      </div>
      <p class="small muted" style="margin-top:10px">No badge wall. Come by, 1660 N Rosemont, Mesa, shop is open, wall of job photos inside.</p>
    </div>
    <div class="hero__media reveal in">
      <div class="hero__frame">
        <img src="https://images.pexels.com/photos/9242888/pexels-photo-9242888.jpeg?auto=compress&cs=tinysrgb&w=1200" alt="HVAC tech at condenser, Mesa rooftop" width="1200" height="800" loading="eager" decoding="async" fetchpriority="high" />
        <div class="hero__frame-cap"><span>Before to After — Arcadia</span><span>48h turnaround</span></div>
      </div>
      <div class="coupon"><span class="coupon__tag">BOGO $47 tune-up</span><p style="font-weight:700;margin-top:8px">Two tune-ups, one price, this week.</p><p class="small muted">AC + furnace, filter included. Mention van 7.</p><a href="#book" class="link-arrow" style="margin-top:8px">Claim coupon <span class="arr" aria-hidden>→</span></a></div>
      <p style="font-family:var(--font-mono);font-size:11px;color:var(--ink-3);margin-top:10px">Straight photography — Shot on site, not stock</p>
    </div>
  </div>
</section>

<section class="triage reveal" id="triage">
  <div class="container triage__grid">
    <div>
      <p class="kicker">Is it blowing warm?</p>
      <h2 style="margin-top:8px">Pick your symptom, we confirm on-site</h2>
      <p class="small" style="color:var(--ink-2);margin-top:8px;max-width:34ch">Homeowner words, not SKU copy. Diagnostic flat, waived on repair. 4.9 on Google from 1,2xx Mesa jobs.</p>
    </div>
    <div class="sym-grid" role="group" aria-label="Symptoms">
      <button class="sym" type="button">No cool air</button>
      <button class="sym" type="button">No heat</button>
      <button class="sym" type="button">Hot and cold spots</button>
      <button class="sym" type="button">Rattle or hiss</button>
      <button class="sym" type="button">Water by unit</button>
      <button class="sym" type="button">Burnt smell</button>
    </div>
  </div>
</section>

<section class="visit reveal" id="visit">
  <div class="container visit__grid">
    <div>
      <h2 style="color:#fff">Today, in 3 steps</h2>
      <div class="visit__row"><div class="visit__n">01</div><div><h3 style="color:#fff">Call, get a 2-hour window</h3><p class="small" style="color:#A8B2BF">Yadira answers, checks the plate by photo.</p></div></div>
      <div class="visit__row"><div class="visit__n">02</div><div><h3 style="color:#fff">Diagnose, flat price</h3><p class="small" style="color:#A8B2BF">Photo of the failed part before any work.</p></div></div>
      <div class="visit__row" style="border-bottom:none"><div class="visit__n">03</div><div><h3 style="color:#fff">Fix or order, photo filed</h3><p class="small" style="color:#A8B2BF">Same-day coil, cap, charge. 14-day check included.</p></div></div>
    </div>
