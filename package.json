{
  "name": "tina-astro-blocks-starter",
  "type": "module",
  "version": "1.0.0",
  "description": "Reusable Astro + TinaCMS blocks starter — generic blocks, visual editing, Cloudflare-ready",
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "build": "tinacms build && astro build",
    "build:local": "tinacms build --local --skip-cloud-checks && astro build",
    "preview": "astro preview",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/mdx": "^6.0.2",
    "@tinacms/astro": "^0.7.0",
    "astro": "^6.4.4",
    "tinacms": "^3.14.0"
  },
  "devDependencies": {
    "@tinacms/cli": "^3.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.34.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
