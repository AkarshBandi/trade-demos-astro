{
  "name": "trade-demos-astro",
  "type": "module",
  "version": "1.0.0",
  "description": "Trade demos — HVAC Apex Air Pros (Mesa AZ) + Roofing Summit Co (Frisco TX) — Cloudflare Workers, TinaCMS local",
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "build": "tinacms build && astro build",
    "build:local": "tinacms build --local --skip-cloud-checks && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint:design": "node scripts/design-slop-detect.mjs src/pages/prototype.astro src/pages/roofing-prototype.astro",
    "lint:tokens": "stylelint 'src/**/*.{css,astro}'",
    "lint": "npm run lint:design && npm run lint:tokens && npm run lint:copy",
    "lint:copy": "node scripts/copy-slop-detect.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/mdx": "^8.0.2",
    "@tinacms/astro": "^0.7.0",
    "astro": "^7.3.5",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "slate": "^0.124.1",
    "slate-dom": "^0.124.1",
    "tinacms": "^3.14.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tinacms/cli": "^3.1.0",
    "postcss-html": "^2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.34.0",
    "stylelint": "^17.15.0",
    "stylelint-design-token-guard": "^0.4.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
